  "services": {
    "mow_areas": {
      "name": "Mow areas",
      "description": "Start a select-area (zone) mow using saved-map boundaries. Use the \"List areas\" action (or the Roborock app) to find the area ids.",
      "fields": {
        "device_id": {
          "name": "Mower",
          "description": "The Roborock mower(s) to use."
        },
        "area_ids": {
          "name": "Area ids",
          "description": "One or more saved boundary/zone ids to mow."
        },
        "area_names": {
          "name": "Area names",
          "description": "Optional names matching each area id (same order). Cosmetic; the mower resolves areas by id."
        }
      }
    },
    "list_areas": {
      "name": "List areas",
      "description": "Return the mower's saved areas, map names and map boundaries (best effort).",
      "fields": {
        "device_id": {
          "name": "Mower",
          "description": "The Roborock mower(s) to query."
        },
        "map_name": {
          "name": "Map name",
          "description": "Optional saved-map name to query (defaults to the active map)."
        }
      }
    },
    "query": {
      "name": "Query the mower",
      "description": "Ask the mower a read-only question (GET_* query) and return its raw answer. Discovery aid for data the integration does not show yet, e.g. maintenance values. Never moves the mower or changes settings.",
      "fields": {
        "device_id": {
          "name": "Mower",
          "description": "The Roborock mower(s) to ask."
        },
        "query_type": {
          "name": "Query type",
          "description": "Name of the read-only query, e.g. GET_ROBOT_STATUS. Must start with GET_."
        },
        "payload": {
          "name": "Extra fields",
          "description": "Optional additional fields for the query."
        }
      }
    },
    "scan_queries": {
      "name": "Scan mower queries",
      "description": "Tries a list of read-only queries (GET_*) on the mower one after another and returns which ones it answers. Helps to find data the integration does not show yet, such as blade wear or mowing statistics. Never moves the mower or changes settings; takes up to a few minutes.",
      "fields": {
        "device_id": {
          "name": "Mower",
          "description": "The Roborock mower(s) to scan."
        },
        "query_types": {
          "name": "Queries",
          "description": "Optional list of query names to try (each must start with GET_). Without it, a built-in list of likely names is tried."
        }
      }
    }
  }
