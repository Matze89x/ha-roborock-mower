  "services": {
    "mow_areas": {
      "name": "Zonen mähen",
      "description": "Startet das Mähen ausgewählter, gespeicherter Zonen. Die Zonen-IDs liefert die Aktion „Zonen auflisten“ (oder die Roborock-App).",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die zu verwendende(n) Roborock-Mähroboter."
        },
        "area_ids": {
          "name": "Zonen-IDs",
          "description": "Eine oder mehrere IDs gespeicherter Zonen."
        },
        "area_names": {
          "name": "Zonennamen",
          "description": "Optionale Namen passend zu den IDs (gleiche Reihenfolge). Nur kosmetisch."
        }
      }
    },
    "list_areas": {
      "name": "Zonen auflisten",
      "description": "Gibt die gespeicherten Zonen, Kartennamen und Kartengrenzen des Mähers zurück (nach bestem Bemühen).",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die abzufragende(n) Roborock-Mähroboter."
        },
        "map_name": {
          "name": "Kartenname",
          "description": "Optionaler Name der gespeicherten Karte (Standard: aktive Karte)."
        }
      }
    },
    "query": {
      "name": "Mäher abfragen",
      "description": "Stellt dem Mäher eine reine Lese-Abfrage (GET_*) und gibt seine Rohantwort zurück. Hilfsmittel, um Daten zu finden, die die Integration noch nicht anzeigt, z. B. Wartungswerte. Bewegt den Mäher nie und ändert keine Einstellungen.",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die abzufragende(n) Roborock-Mähroboter."
        },
        "query_type": {
          "name": "Abfrage",
          "description": "Name der Lese-Abfrage, z. B. GET_ROBOT_STATUS. Muss mit GET_ beginnen."
        },
        "payload": {
          "name": "Zusätzliche Felder",
          "description": "Optionale weitere Felder für die Abfrage."
        }
      }
    },
    "scan_queries": {
      "name": "Mäher-Abfragen durchsuchen",
      "description": "Stellt dem Mäher nacheinander reine Lese-Abfragen (GET_*) und gibt zurück, welche er beantwortet. Standardmäßig werden die Abfragenamen aus der offiziellen Roborock-App-Erweiterung genommen, die – wie von der App – mit deinem eigenen Konto geladen wird; sonst wird eine kurze eingebaute Liste probiert. Hilft, Daten zu finden, die die Integration noch nicht anzeigt, z. B. Zeitpläne, Messerverschleiß oder Mähstatistiken. Bewegt den Mäher nie und ändert keine Einstellungen; kann einige Minuten dauern.",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die zu durchsuchende(n) Roborock-Mähroboter."
        },
        "from_app": {
          "name": "Namen aus der Roborock-App",
          "description": "Abfragenamen aus der offiziellen App-Erweiterung nehmen (empfohlen). Wird ignoriert, wenn unten Abfragen angegeben sind."
        },
        "query_types": {
          "name": "Abfragen",
          "description": "Optionale Liste von Abfragenamen (jeweils mit GET_ beginnend)."
        }
      }
    },
    "app_strings": {
      "name": "App-Texte suchen",
      "description": "Lädt die offizielle Roborock-App-Erweiterung des Mähers (mit deinem eigenen Konto, wie die App) und gibt ihre Texte zurück, die eines der angegebenen Wörter enthalten, z. B. die genauen Namen von Einstellungswerten. Hilfsmittel, um weitere Einstellungen auswählbar zu machen.",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die Roborock-Mähroboter, deren App-Erweiterung durchsucht wird."
        },
        "contains": {
          "name": "Enthält",
          "description": "Ein oder mehrere Wörter (mindestens 3 Zeichen), Groß-/Kleinschreibung egal, z. B. DEFLECTION."
        }
      }
    },
    "save_map_data": {
      "name": "Kartendaten speichern",
      "description": "Fragt den Mäher nach seiner Karte und zeichnet alles auf, was er während der Wartezeit sendet. Die Antwort enthält die Daten, sodass du sie einfach kopieren kannst: JSON lesbar, Protobuf entschlüsselt mit geschwärzter GPS-Position, andere Binärdaten als Base64. Alles wird auch als Dateien im Ordner roborock_mower deiner Konfiguration gespeichert; die Diagnose listet nur auf, was ankam. Dient dazu, das Kartenformat zu entschlüsseln. Kartendaten können deinen Garten zeigen: nur privat weitergeben.",
      "fields": {
        "device_id": {
          "name": "Mähroboter",
          "description": "Der/die aufzuzeichnende(n) Roborock-Mähroboter."
        },
        "wait": {
          "name": "Wartezeit",
          "description": "Wie lange nach der Anfrage aufgezeichnet wird (Sekunden). Länger beim Mähen zeigt auch den Weg."
        }
      }
    }
  }
}
